# Supabase değerleri .env içinde hazır. Bu dosyayı .env.local olarak kopyalayıp RevenueCat anahtarlarını doldur. Hepsi uygulamaya gömülen, herkese açık anahtarlar;
# gizli anahtarlar (service role, RevenueCat sk_..., Anthropic) asla buraya yazılmaz, Supabase'de durur.

# Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxx

# RevenueCat > Project > API keys (platforma özel, herkese açık anahtarlar)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxx

# AdMob: gerçek kimlikler .env'e DEĞİL .env.local'e (git'e girmez) ve EAS ortam değişkenlerine yazılır. Bkz. docs/reklam.md
# Uygulama kimlikleri (~ işaretli). Boşsa app.json'daki Google test kimlikleri kullanılır.
EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=ca-app-pub-xxxxxxxx~xxxxxxxx
EXPO_PUBLIC_ADMOB_APP_ID_IOS=ca-app-pub-xxxxxxxx~xxxxxxxx
# Banner reklam birimleri (/ işaretli). Boşsa geliştirmede Google'ın test reklamı, yayında hiç reklam çıkmaz.
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=ca-app-pub-xxxxxxxx/xxxxxxxx
EXPO_PUBLIC_ADMOB_BANNER_IOS=ca-app-pub-xxxxxxxx/xxxxxxxx
