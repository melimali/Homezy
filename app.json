{
  "expo": {
    "name": "Safehouse: Daily Ops",
    "slug": "layfapp",
    "scheme": "layfapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-kare.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.meikaidigital.layfapp"
    },
    "android": {
      "package": "com.meikaidigital.layfapp",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/logo-kare.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-kare.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#E7E3D8",
          "dark": {
            "image": "./assets/logo-kare.png",
            "backgroundColor": "#1E2022"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F3B553",
          "defaultChannel": "sabah-ozeti"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Erzak taraması ve günlük fotoğraflarını galeriden seçebilmen için Safehouse: Daily Ops fotoğraflarına erişmek istiyor.",
          "cameraPermission": "Erzak deposunu ve keşif teçhizatını tarayabilmen için Safehouse: Daily Ops kameraya erişmek istiyor.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/baloo-2/700Bold/Baloo2_700Bold.ttf",
            "./node_modules/@expo-google-fonts/nunito/600SemiBold/Nunito_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/nunito/700Bold/Nunito_700Bold.ttf",
            "./node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf"
          ],
          "widgets": [
            {
              "name": "Bugun",
              "label": "Safehouse · Seferler",
              "description": "Bugünün tahkimat görevleri, hayatta kalma serin ve günün telsiz notu. Görevi widget'tan tahkim edebilirsin.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "520dp",
              "maxResizeHeight": "340dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
